# ==============================================================================
# DevStudio - Örnek Çevre Değişkenleri (.env.example)
# ==============================================================================

# Veritabanı (Google Cloud SQL PostgreSQL)
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/devstudio?sslmode=require"

# NextAuth.js v5 Yapılandırması
AUTH_SECRET="ornek_auth_secret_en_az_32_karakterlik_guclu_rastgele_metin"
NEXTAUTH_URL="http://localhost:3008"

# Uygulama Ayarları
NEXT_PUBLIC_APP_URL="https://devstudio.bugunai.com"
NEXT_PUBLIC_APP_NAME="DevStudio"

# API Anahtarları Kripto Anahtarı (AES-256 Vault)
ENCRYPTION_KEY="ornek_32_byte_hex_anahtar"
